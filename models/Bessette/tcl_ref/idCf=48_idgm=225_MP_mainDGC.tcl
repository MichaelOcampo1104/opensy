    puts "($offset) $DTPrev"
    analyze 1 $DTPrev
    set DTSum [expr $DTSum + $DTPrev]
    set DTPrev [expr $DTPrev + $LinspaceH]
}
set DT0 0.5
set DT1 0.005
set NSteps 10
set LinspaceH [expr ($DT1-$DT0)/($NSteps-1)]
set DTPrev $DT0
for {set i 0} {$i < $NSteps} {incr i; incr offset} {
    puts "($offset) $DTPrev"
