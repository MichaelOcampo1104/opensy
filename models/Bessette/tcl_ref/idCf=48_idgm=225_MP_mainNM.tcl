#--------------------------------------------------------------------------------------------------
#          13 - GROUND MOTION
#--------------------------------------------------------------------------------------------------

set dataDirWM WithinMotions
set GaccelWM "Series -dt [lindex $matGMDT $idgmi-1] -filePath $dataDirWM/$fileWMID.out -factor 9.81"
pattern UniformExcitation 1 1 -accel $GaccelWM;                             # Acceleration tag:1 at x-direction

puts "Dynamic loading created..."

#--------------------------------------------------------------------------------------------------
#          14 - CREATE POST-GRAVITY RECORDERS 
#--------------------------------------------------------------------------------------------------

source recorderNM.tcl

puts "Created dynamic recorders..."
if {$process_id == 0} {
	    set fid [open "$dataDir2/MethodRun_idCf48.out" a]
	    	puts $fid "2"
	    	close $fid
}
#--------------------------------------------------------------------------------------------------
#          15 - STAGE 3 - ANALYSES COMMANDS
#--------------------------------------------------------------------------------------------------

puts "Starting dynamic analysis..."

wipeAnalysis
# analyses command
constraints Penalty 1e15 1e15
numberer ParallelRCM
system Mumps -ICNTL14 200
test NormDispIncr 0.02 8 0
algorithm KrylovNewton -iterate current
integrator Newmark 0.51 0.26
analysis Transient
analyze 0 0.0

#--------------------------------------------------------------------------------------------------
#          16 - PERFORM INCREMENTAL DYNAMIC ANALYSIS
#--------------------------------------------------------------------------------------------------

set duration [lindex $matGMdur1 $idgmi-1]
set dT0 [lindex $matGMDT $idgmi-1]
set currentTime 0.0
set maxFactor 2.0
set minFactor 1.0E-6
set maxFactorIncrement 2.0
set minFactorIncrement 0.0
set maxIter 100
set desiredIter 30
set factor 1.0
set oldFactor $factor

set flagDriftok 0
if {$process_id == 0} {
# Drift calculation - define variables
set StHeight 4
set DriftLimit 0.08
set ntagFnd 5000001
set FndDisp0 [nodeDisp $ntagFnd 1]
set ntagSt1 3000004
set F1Disp0 [nodeDisp $ntagSt1 1]
# rocking drift calculation
set ntagFndL 5000001
set FndDispL0 [nodeDisp $ntagFnd 3]
set ntagFndR 5000002
set FndDispR0 [nodeDisp $ntagFnd 3]
set Bmod 5.0
}
puts "BEGIN STAGE 3.1 - INCREMENTAL DYNAMIC ANALYSIS WITH ADAPTIVE TIME-STEP CONTROL"
puts "Duration 3.1 = $duration s"
puts "Initial dT = $dT0"

while 1 {

	incr incrementCounter
	# compute next time increment, make sure not to exceed max duration
	set dT [expr $dT0 * $factor]
	if {[expr $currentTime + $dT] >  $duration} {
		set dT [expr $duration - $currentTime]
	}
	set ok [analyze 1 $dT $dT 1]

if {$process_id == 0} {
	# interstory rocking drift ratio calculation
	set FndDispL [expr [nodeDisp $ntagFndL 3] - $FndDispL0]
	set FndDispR [expr [nodeDisp $ntagFndR 3] - $FndDispR0]
	set rock_rot [expr {atan(($FndDispL - $FndDispR) / $Bmod)}]
	set sgn [expr {($rock_rot > 0) ? 1 : (($rock_rot < 0) ? -1 : 0)}]

    set drift_rock_perfloor [expr {($sgn * sqrt(2 * (1 - cos($rock_rot)))) * 4}]
    if {$incrementCounter == 1} {
        set drift_rock_perfloor0 $drift_rock_perfloor
    } else {
    }
   set drift_rock_perfloor [expr $drift_rock_perfloor - $drift_rock_perfloor0]

    set outputFileDriftRock [open "$dataDir1/DriftRock-part0.out" "a"]
    puts $outputFileDriftRock "$currentTime $drift_rock_perfloor"
    close $outputFileDriftRock

    # interstory total drift ratio calculation
    # Floor 1
    set flagDriftok 0
    set FndDisp [expr [nodeDisp $ntagFnd 1] - $FndDisp0]
    set F1Disp [expr [nodeDisp $ntagSt1 1] - $F1Disp0]
    set DriftTF1 [expr $F1Disp - $FndDisp]

    set outputFileDriftTF1 [open "$dataDir1/DriftTF1-part0.out" "a"]
    puts $outputFileDriftTF1 "$currentTime $DriftTF1"
    close $outputFileDriftTF1

    set DriftFF1 [expr {$DriftTF1 - $drift_rock_perfloor}]

    set outputFileDriftFF1 [open "$dataDir1/DriftFF1-part0.out" "a"]
    puts $outputFileDriftFF1 "$currentTime $DriftFF1"
    close $outputFileDriftFF1

    set absolute_values [lmap value [concat $DriftFF1] {expr {abs($value)}}]
    set maxdrift 0
    foreach val $absolute_values { if {$val > $maxdrift} { set maxdrift $val } }
	# Check if story drift exceeds 5%
	if {[expr $maxdrift/$StHeight] > $DriftLimit} {
	    puts "Warning: One or more interstory flexural drift values exceeds the DriftLimit:$DriftLimit% threshold at time $currentTime seconds."
	    set flagDriftok 1
	    puts "Terminating analysis..."

	    set fid [open "$dataDir2/UnsuccessfulCollapseNM_idCf48.out" a]
	    puts $fid "$idgmout "
	    close $fid
	    break
	}

}
	if {$ok == 0} {
		set currentTime [expr $currentTime + $dT]
		set percentage [expr $currentTime / $duration]
		if {$percentage > 1.0} {
			set percentage 1.0
		}

		puts "Analysis Progress: [expr $percentage*100.0] %, $currentTime s"
		if {$currentTime >= $duration} {
			puts "Dynamic Analysis successfully completed."
           if {$process_id == 0} {
	    set fid [open "$dataDir2/SuccessfulNLNM_idCf48.out" a]
	    	puts $fid "$idgmout"
	    	close $fid
           }
			break
		}

		set numIter [testIter]
		set factorIncrement [expr min($maxFactorIncrement, [expr double($desiredIter) / double($numIter)])]
		set factor [expr $factor * $factorIncrement]
		if {$factor > $maxFactor} {
			set factor $maxFactor
		}
		if {$factor > $oldFactor} {
			puts "Increasing increment factor due to faster convergence. Factor = $factor"
		}
		set oldFactor $factor
	} else {
		set numIter $maxIter
		set factorIncrement [expr max($minFactorIncrement, [expr double($desiredIter) / double($numIter)])]
		set factor [expr $factor * $factorIncrement]
		puts "Reducing increment factor due to non convergence. Factor = $factor"
		if {$factor < $minFactor} {
			puts "ERROR: current factor is less then the minimum allowed ($factor < $minFactor)"
			puts "Giving up - Dynamic analysis did not converge"
			set fid [open "$dataDir2/UnsuccessfulNLNM_idCf48.out" a]
			puts $fid "$idgmout "
			close $fid
			break
		}
	}
}


puts "DONE STAGE 3.1 - INCREMENTAL DYNAMIC ANALYSIS WITH ADAPTIVE TIME-STEP CONTROL"

if {$flagDriftok == 0} {

	remove recorders
	source recorderNMdiff.tcl

	puts "Created dynamic diffusion recorders..."
	#--------------------------------------------------------------------------------------------------
	#          17 - PERFORM INCREMENTAL DIFFUSION ANALYSIS WITH LARGER TIME STEP
	#--------------------------------------------------------------------------------------------------

	puts "BEGIN STAGE 3.2 - INCREMENTAL DIFFUSION ANALYSIS WITH ADAPTIVE TIME-STEP CONTROL"

	set duration [expr [lindex $matGMdur2 $idgmi-1]-0.01]

	puts "STAGE 3.2 - Duration: $duration s"

	set dT0 0.5
	set currentTime 0.0
	set maxFactor 8.0
	set minFactor 1.0E-6
	set maxFactorIncrement 2.0
	set minFactorIncrement 0.0
	set maxIter 100
	set desiredIter 30
	set factor 1.0
	set oldFactor $factor

	puts ""
	puts "BEGIN STAGE 3.2 - INCREMENTAL DIFFUSION ANALYSIS WITH ADAPTIVE TIME-STEP CONTROL"
	puts "Duration = $duration s"
	puts ""
	puts "Initial dT = $dT0"

	while 1 {

		incr incrementCounter
		# compute next time increment, make sure not to exceed max duration
		set dT [expr $dT0 * $factor]
		if {[expr $currentTime + $dT] >  $duration} {
			set dT [expr $duration - $currentTime]
		}
		set ok [analyze 1 $dT $dT 1]

		if {$ok == 0} {
			set currentTime [expr $currentTime + $dT]
			set percentage [expr $currentTime / $duration]
			if {$percentage > 1.0} {
				set percentage 1.0
			}

			puts "Analysis Progress: [expr $percentage*100.0] %"
			if {$currentTime >= $duration} {
				record
				puts "Dynamic Analysis successfully completed."
				puts ""
				break
			}

			set numIter [testIter]
			set factorIncrement [expr min($maxFactorIncrement, [expr double($desiredIter) / double($numIter)])]
			set factor [expr $factor * $factorIncrement]
			if {$factor > $maxFactor} {
				set factor $maxFactor
			}
			if {$factor > $oldFactor} {
				puts "Increasing increment factor due to faster convergence. Factor = $factor"
			}
			set oldFactor $factor
		} else {
			set numIter $maxIter
			set factorIncrement [expr max($minFactorIncrement, [expr double($desiredIter) / double($numIter)])]
			set factor [expr $factor * $factorIncrement]
			puts "Reducing increment factor due to non convergence. Factor = $factor"
			if {$factor < $minFactor} {
				puts "ERROR: current factor is less then the minimum allowed ($factor < $minFactor)"
				puts "Giving up - Dynamic analysis did not converge"
				puts ""
				break
			}
		}
	}

	set endT    [clock seconds]

	puts "Dynamic+Diffusion Analysis succesfully completed."
	puts "Recording outputs idgm in successful.out + run time..."
if {$process_id == 0} {
	set fid [open "$dataDir2/SuccessfulANM_idCf48.out" a]
	puts $fid "$idgmout [expr [expr $endT-$startT]/3600]"
	close $fid
}
}

set endT    [clock seconds]

if {$process_id == 0} {
puts "DONE MOTION idgm: [lindex $matGMid $index-1]"
puts "Analysis execution time idgm: [lindex $matGMid $index-1]: [expr $endT-$startT] seconds"

puts " "
}
# Reset time and analysis
loadConst 0.0
setTime 0.0
wipeAnalysis
remove recorders

wipe
}
