#--------------------------------------------------------------------------------------------------
#          9 - STAGE 1 - GRAVITY ANALYSIS ELASTIC COMMANDS
#--------------------------------------------------------------------------------------------------

puts "BEGIN STAGE 1 - ELASTIC ANALYSIS WITH SOIL SELF WEIGHT"

# analyses command
constraints Penalty 1000000000000000.0 1000000000000000.0
numberer ParallelRCM
system Mumps -ICNTL14 200
test NormDispIncr 0.001 100 2
algorithm KrylovNewton -iterate current
integrator Newmark 0.51 0.26
analysis Transient
analyze 10 500.0

loadConst -time 0.0

puts "DONE STAGE 1 - ELASTIC GRAVITY ANALYSIS WITH SOIL SELF WEIGHT"

