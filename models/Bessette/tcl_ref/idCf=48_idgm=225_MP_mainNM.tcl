#--------------------------------------------------------------------------------------------------

set timeSeries_list_of_times_2 {0.0 2500.0 10000.0}
set timeSeries_list_of_values_2 {0.0 1.0 1.0}
timeSeries Path 2 -time $timeSeries_list_of_times_2 -values $timeSeries_list_of_values_2
pattern Plain 500 2 {
