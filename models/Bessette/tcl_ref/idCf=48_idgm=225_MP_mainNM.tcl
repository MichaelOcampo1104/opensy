#--------------------------------------------------------------------------------------------------
#          5 - UPDATE SOIL MATERIAL STAGE ELASTIC
#--------------------------------------------------------------------------------------------------

# soil material stage : elastic
updateMaterialStage -material 11 -stage 0
updateMaterialStage -material 20 -stage 0
updateMaterialStage -material 70 -stage 0
updateMaterialStage -material 71 -stage 0
updateMaterialStage -material 90 -stage 0

#--------------------------------------------------------------------------------------------------
#          6 - RAYLEIGH DAMPING - SOIL & STRUCT.
#--------------------------------------------------------------------------------------------------

# Misc_commands region

# Soil Rayleigh Damping
set pi 3.141592654
set damp 0.03
set omega1 [expr 2*$pi*3.96]
set omega2 [expr 2*$pi*11.88]
set a0 [expr 2*$damp*$omega1*$omega2/($omega1 + $omega2)]
set a1 [expr 2*$damp/($omega1 + $omega2)]

region 4 \
-eleRange 1 2032 \
-rayleigh $a0 0.0 $a1 0.0

puts "Soil Rayleigh Damping coefficients: a_0 = $a0;  a_1 = $a1"

set T1 0.86626
set T2 0.05051
puts "T1 = $T1;  T_2 = $T2"

# Structure Rayleigh Damping
set pi 3.141592654
set damp 0.05
set f1 [expr 1/$T1]
set f2 [expr 1/$T2]
set omega1 [expr 2.0*$pi*$f1]
set omega2 [expr 2.0*$pi*$f2]
set a0 [expr 2*$damp*$omega1*$omega2/($omega1 + $omega2)]
set a1 [expr 2*$damp/($omega1 + $omega2)]

region 700 \
-eleRange 600001 600004 \
-rayleigh 0.0 0.0 0.0 $a1;          # select only zero lengths and assign only stiffness-proportional term a1

region 800 \
-eleRange 4000001 4000013 \
-rayleigh $a0 0.0 0.0 0.0;          # select only stiff beams with mass and assign only mass-proportional term a0

region 900 \
-node 3000003 3000004 3000005 3000006  \
-rayleigh $a0 0.0 0.0 0.0;          # assign mass proportional damping to structure (only assigns to nodes with mass)

puts "Structure Rayleigh Damping coefficients: a_0 = $a0;  a_1 = $a1"

#--------------------------------------------------------------------------------------------------
#          7 - GEOSTATIC RECORDER
#--------------------------------------------------------------------------------------------------

set dataDir1 NM/GM[lindex $matGMid $idgmi-1]
set dataDir2 NM
file mkdir $dataDir1
file mkdir $dataDir2

if {$process_id == 0} {
recorder Node -file $dataDir1/Found_disp_geostatic_idCf48_GM[lindex $matGMid $idgmi-1]-part0.out -time -node 100156 -dof 1 2 3 disp
}
if {$process_id == 0} {
recorder Node -file $dataDir1/Roof_disp_geostatic_idCf48_GM[lindex $matGMid $idgmi-1]-part0.out -time -node 3000004 -dof 1 3 disp

}
set recDTstress 0.1
if {$process_id == 0} {
set soilelement {121 123 124 126 127 129 130 131 139 140 161 163 164 166 167 169 170 171 179 180}
   eval "recorder Element -file $dataDir1/soilstress23_geostatic_idCf48_GM[lindex $matGMid $idgmi-1]-part0.out -time -dT $recDTstress -ele $soilelement material 23 stress"
   eval "recorder Element -file $dataDir1/soilstress27_geostatic_idCf48_GM[lindex $matGMid $idgmi-1]-part0.out -time -dT $recDTstress -ele $soilelement material 27 stress"
   eval "recorder Element -file $dataDir1/soilstress26_geostatic_idCf48_GM[lindex $matGMid $idgmi-1]-part0.out -time -dT $recDTstress -ele $soilelement material 26 stress"
} elseif {$process_id == 1} {
set soilelement {846 847 849 850 851 859 860 883 884 886 887 888 896 897 985 986 988 989 990 998 999 1019 1020 1022 1023 1024 1032 1033 1121 1122 1124 1125 1126 1134 1135 1158 1159 1161 1162 1163 1171 1172}
   eval "recorder Element -file $dataDir1/soilstress23_geostatic_idCf48_GM[lindex $matGMid $idgmi-1]-part1.out -time -dT $recDTstress -ele $soilelement material 23 stress"
   eval "recorder Element -file $dataDir1/soilstress27_geostatic_idCf48_GM[lindex $matGMid $idgmi-1]-part1.out -time -dT $recDTstress -ele $soilelement material 27 stress"
   eval "recorder Element -file $dataDir1/soilstress26_geostatic_idCf48_GM[lindex $matGMid $idgmi-1]-part1.out -time -dT $recDTstress -ele $soilelement material 26 stress"
} elseif {$process_id == 2} {
set soilelement {1833 1835 1836 1838 1839 1841 1842 1843 1851 1852 1873 1875 1876 1878 1879 1881 1882 1883 1891 1892}
   eval "recorder Element -file $dataDir1/soilstress23_geostatic_idCf48_GM[lindex $matGMid $idgmi-1]-part2.out -time -dT $recDTstress -ele $soilelement material 23 stress"
   eval "recorder Element -file $dataDir1/soilstress27_geostatic_idCf48_GM[lindex $matGMid $idgmi-1]-part2.out -time -dT $recDTstress -ele $soilelement material 27 stress"
   eval "recorder Element -file $dataDir1/soilstress26_geostatic_idCf48_GM[lindex $matGMid $idgmi-1]-part2.out -time -dT $recDTstress -ele $soilelement material 26 stress"
}
