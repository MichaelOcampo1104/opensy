#####################
puts "Gravity Analysis"
#####################

constraints Transformation
numberer RCM
system UmfPack
test NormDispIncr 1.000000e-06 1000 0 2
algorithm KrylovNewton 
integrator LoadControl 0.100000
analysis Static
set ok [analyze 10]
if {$ok == 0} {puts "Gravity Analysis Success" } else {puts "Gravity Analysis Failed"} 
loadConst -time 0.0

#####################
puts "Stiffness Check"
#####################


#####################
puts "Pushover Analysis"
#####################


#####################
puts "Cyclic Static Analysis"
#####################


#####################
puts "Time History Analysis"
#####################

constraints Transformation
numberer RCM
test NormDispIncr 1.000000e-06 1000 0 2
integrator Newmark 0.500000 0.250000
algorithm Newton
analysis Transient
pattern UniformExcitation 400 1 -accel 1
system UmfPack
test NormDispIncr 1.000000e-06 1000 0 2
algorithm KrylovNewton 
set inicio [clock seconds]
source ../../01Procs.tcl
unidades kip in
set DirAna 1;


set incrInte [expr 0.010000*$in]
set factInte [list 0.5 0.05 0.02 0.001]

set algoO KrylovNewton
set listAlgo [list 10 4 14]

set nombTest NormDispIncr
set unidTest in
set toleTest [expr 1e-8*$in]
set factTest [list 1e1 1e2 1e3]
set iteTestN 50; set iteTestF 100
set pflagN   0 ; set pflagF   1

set cuenta    [list 0 [llength $factInte] 0 [llength $listAlgo] 0 [llength $factTest]]
set numFailures 0
set totFailures 0

set Nsteps 8000
set step 0
set analisis 0
set factAnal 1.0
	while {$step < [expr $Nsteps +1]} {

		set analisis [analyze [expr int([expr 1.0/$factAnal])] [expr 0.005*$factAnal]]

		if {$analisis != 0 } {

			incr totFailures
			incr numFailures
			set  cuenta [cuentaSols $cuenta]

			if {$cuenta==-1} {
				puts "
	After $numFailures attempts to solve the step, the adaptive solution failed.
			            	              
	Breaking the analysis. The adaptive solution approach was activated $totFailures times.\
				                          
	Last converged time-step: $step/$Nsteps\
			                              
	Total time elapsed: [tiempo $inicio 1]"
             return

			}

			set factAnal [lindex $factInte [expr [lindex $cuenta 0]]-1]
			set msnAlgo [defAlgo $listAlgo [lindex $cuenta 2]]
			set msnTest [defTest $nombTest $toleTest $factTest $iteTestF [lindex $cuenta 4] $unidTest $pflagF]
			puts "
		The solution approach has failed $numFailures times when departing from step $step/$Nsteps solved, now trying: ([tiempo $inicio 1])\
				                
		Time step reduced by $factAnal\
				                
		$msnAlgo\
				                
		$msnTest \
				                
		Count: Integrator [lindex $cuenta 0]/[lindex $cuenta 1], Algorithm [lindex $cuenta 2]/[lindex $cuenta 3], Test [lindex $cuenta 4]/[lindex $cuenta 5]
"
		}

		if {$analisis == 0 && $numFailures > 0} {
			puts "	Worked!!
				  
					step $step/$Nsteps solved ([tiempo $inicio]) \
			      
					Returned to the original solving approach.
"

			test        $nombTest $toleTest $iteTestN $pflagN
			algorithm   $algoO
			set factAnal 1.0
			incr step

			# Reset controlling variables to the original
			set cuenta [list 0 [llength $factInte] 0 [llength $listAlgo] 0 [llength $factTest]]
			set numFailures 0

		} elseif {$analisis == 0} { 
			puts "		$step/$Nsteps solved ([tiempo $inicio])"
	        incr step

		}

}

puts "
	The adaptive solution approach was activated $totFailures times"
puts "
	Pushover analysis finished successfully"
wipe all

if {$ok == 0} {puts "Analysis Success"} else { puts "Analysis Failed" }

#####################
puts "Close File"
#####################

wipe;
puts "Models Run Complete";
