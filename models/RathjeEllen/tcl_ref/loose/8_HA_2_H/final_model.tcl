#-----------------------------------------------------------------------------------------
#  10. CREATE POST-GRAVITY RECORDERS
#-----------------------------------------------------------------------------------------

# reset time and analysis
setTime 0.0
wipeAnalysis
remove recorders



# define velocity time history file
set velocityFile $path/motion1.vel
set accFile  $path/motion1.acc
set timeFile $path/motion1.time

#---GROUND MOTION PARAMETERS
# read number of lines in the velocity file
set channel [open $timeFile r]
set timeVec [split [read -nonewline $channel] \n]
set motionSteps [llength $timeVec]
set t1 [lindex $timeVec 0]
set t2 [lindex $timeVec 1]
set motionDT [expr $t2 - $t1]
close $channel

set duration [expr $motionSteps * $motionDT]

# new dt to use for analysis
# set motionDT 0.0025
# set motionSteps [expr int($duration / $motionDT) + 1]

set AnalysisdT  0.001
set RecorderdT 0.01
set nSteps  [expr int(floor($duration/$AnalysisdT)+1)]
set dT      $AnalysisdT

puts "Number of motion steps: $motionSteps"
puts "Motion time step: $motionDT"
puts "Motion length: $duration"


# record nodal displacement, acceleration, and pore pressure
eval "recorder Node -file $path/displacement.out -time -dT $RecorderdT -node $nodeListS -dof 1 2  disp"
eval "recorder Node -file $path/acceleration.out -time -dT $RecorderdT -node $nodeListS -dof 1 2  accel"
eval "recorder Node -file $path/porePressure.out -time -dT $RecorderdT -node $nodeListS -dof 3    vel"
# record elemental stress and strain
eval "recorder Element -file $path/stress.out -time -dT $RecorderdT -ele $SoilElementList stress 3"
eval "recorder Element -file $path/strain.out -time -dT $RecorderdT -ele $SoilElementList strain"

puts "Finished creating all recorders..."

#-----------------------------------------------------------------------------------------
#  11. DYNAMIC ANALYSIS
#-----------------------------------------------------------------------------------------

# define constant scaling factor for applied velocity
set cFactor [expr $baseArea*$dashpotCoeff]
# timeseries object for force history
set mSeries "Path -fileTime $timeFile -filePath $velocityFile -factor $cFactor"

# loading object
pattern Plain 10 $mSeries {
load 10706  1.0 0.0 0.0
}


puts "Dynamic loading created..."

set gamma  0.5
set beta   0.25

constraints Penalty 1.e15 1.e15
# constraints Transformation
test        NormDispIncr 1.0e-2 35 0
algorithm   Newton
numberer    RCM
system      Mumps
integrator  Newmark $gamma $beta
rayleigh    $a0 $a1 0.0 0.0
analysis    Transient

# Set number and length of (pseudo)time steps
set numStep $nSteps

#set numStep 0

# Analyze and use substepping if needed
set remStep $numStep
set success 0
proc subStepAnalyze {dT subStep} {
        if {$subStep > 10} {
                return -10
        }
        for {set i 1} {$i < 3} {incr i} {
                puts "Try dT = $dT"
                set success [analyze 1 $dT]
                if {$success != 0} {
                        set success [subStepAnalyze [expr $dT/2.0] [expr $subStep+1]]
                        if {$success == -10} {
                                puts "Did not converge."
                                return success
                        }
                } else {
                        if {$i==1} {
                                puts "Substep $subStep : Left side converged with dT = $dT"
                        } else {
                                puts "Substep $subStep : Right side converged with dT = $dT"
                        }
                }
        }
        return success
}

puts "Start analysis"
set startT [clock seconds]

while {$success != -10} {
        set subStep 0
        set success [analyze $remStep  $dT]
        if {$success == 0} {
                puts "Analysis Finished"
                break
        } else {
                set curTime  [getTime]
                puts "Analysis failed at $curTime . Try substepping."
                set success  [subStepAnalyze [expr $dT/2.0] [incr subStep]]
        set curStep  [expr int($curTime/$dT + 1)]
        set remStep  [expr int($numStep-$curStep)]
                puts "Current step: $curStep , Remaining steps: $remStep"
        }
}
set endT [clock seconds]
puts "loading analysis execution time: [expr $endT-$startT] seconds."
wipe

