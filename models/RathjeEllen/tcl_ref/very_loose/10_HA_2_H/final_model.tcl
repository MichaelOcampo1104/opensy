#-----------------------------------------------------------------------------------------
#  4. LYSMER DASHPOT
#-----------------------------------------------------------------------------------------

model BasicBuilder -ndm 2 -ndf 2

# define dashpot nodes
node    11932    -150.000     -24.000
node    11933    -150.000     -24.000

# define fixities for dashpot nodes
fix 11932  1 1
fix 11933  0 1

# define equal DOF for dashpot and base soil node
equalDOF 11832 11933  1
puts "Finished creating dashpot nodes and boundary conditions..."

# define dashpot material
set baseArea 1000400.00
set dashpotCoeff    1750.00
uniaxialMaterial Viscous 5 [expr $dashpotCoeff*$baseArea] 1

# define dashpot element
element zeroLength 11551 11932 11933 -mat 5 -dir 1
puts "Finished creating dashpot material and element..."

#-----------------------------------------------------------------------------------------
#  5. DEFINE NODAL MASSES FOR MODELING WATER
#-----------------------------------------------------------------------------------------

model BasicBuilder -ndm 2 -ndf 3

# define nodal masses 
puts "Finished creating nodal masses..."
#-----------------------------------------------------------------------------------------
#  6. CREATE GRAVITY RECORDERS
#-----------------------------------------------------------------------------------------

# create list with soil node info
set nodeListS {}
set channel [open "$path/nodeInfo.dat" r]
set ctr 0;
foreach line [split [read -nonewline $channel] \n] {
set ctr0 [expr $ctr+1];
set lineData($ctr) $line
set nodeNumber [lindex $lineData($ctr) 0]
lappend nodeListS $nodeNumber
}
close $channel

# create solid element list
set SoilElementList {}
set channel [open "$path/elementInfo.dat" r]
set ctr 0;
foreach line [split [read -nonewline $channel] \n] {
set ctr0 [expr $ctr+1];
set lineData($ctr) $line
set elementNumber [lindex $lineData($ctr) 0]
lappend SoilElementList $elementNumber
}
close $channel

# record nodal displacement, acceleration, and pore pressure
eval "recorder Node -file $path/Gdisplacement.out -time -node $nodeListS -dof 1 2  disp"
eval "recorder Node -file $path/Gacceleration.out -time -node $nodeListS -dof 1 2  accel"
eval "recorder Node -file $path/GporePressure.out -time -node $nodeListS -dof 3    vel"
# record elemental stress and strain
eval "recorder Element -file $path/Gstress.out -time -ele $SoilElementList stress 3"
eval "recorder Element -file $path/Gstrain.out -time -ele $SoilElementList strain"
puts "Finished creating gravity recorders..."


#-----------------------------------------------------------------------------------------
#  7. DEFINE ANALYSIS PARAMETERS
#-----------------------------------------------------------------------------------------

#---RAYLEIGH DAMPING PARAMETERS
set pi      3.141592654
# damping ratio
set damp    0.02
# lower frequency
set omega1  [expr 2*$pi*0.2]
# upper frequency
set omega2  [expr 2*$pi*20]
# damping coefficients
set a0      [expr 2*$damp*$omega1*$omega2/($omega1 + $omega2)]
set a1      [expr 2*$damp/($omega1 + $omega2)]
puts "damping coefficients: a_0 = $a0;  a_1 = $a1"

#---ANALYSIS PARAMETERS
# Newmark parameters
set gamma   [expr 5.0/6.0]
set beta    [expr 4.0/9.0]

#-----------------------------------------------------------------------------------------
#  8. GRAVITY ANALYSIS
#-----------------------------------------------------------------------------------------

# update materials to ensure elastic behavior
updateMaterialStage -material 1 -stage 0
updateMaterialStage -material 2 -stage 0
updateMaterialStage -material 3 -stage 0
updateMaterialStage -material 4 -stage 0

#constraints Transformation
constraints Penalty 1e15 1e15
test        NormDispIncr 1e-2 35 0
algorithm   Newton
numberer    RCM
system      Mumps
integrator  Newmark $gamma $beta
analysis    Transient

set startT  [clock seconds]
analyze     10 5.0e2
puts "Finished with elastic gravity analysis..."

# update materials to consider plastic behavior
updateMaterialStage -material 1 -stage 1
updateMaterialStage -material 2 -stage 1
updateMaterialStage -material 3 -stage 1
updateMaterialStage -material 4 -stage 1
source $path/firstCall.dat

analyze 10 1.0
puts "Finished with plastic gravity analysis..."

