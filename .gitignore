**/.SmartAnalyze-OpenSees.log

# Scratch console logs from model runs (SmartAnalyze progress bars, etc.)
run*.log
run*.txt

# Output directories — generated artifacts only; keep .gitkeep
models/**/output/**
!models/**/output/.gitkeep

# OpenSees output files — large generated artifacts
*.nc
Opensees_references/**/.opstool.output/
Opensees_references/**/_OPSTOOL_ODB/

# Large simulation output data files (>100 MB, rejected by GitHub)
Opensees_references/Geo_expl/**/*.txt

# Python cache
__pycache__/
*.pyc
